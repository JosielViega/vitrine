# Merge these rules into public/uploads/.htaccess on the server.
# Keep any hosting-specific rules already present.

Options -Indexes
Options -ExecCGI

RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar
RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar

<FilesMatch "(?i:\.(php[0-9]?|phtml|phar|phps|cgi|pl|py|sh|shtml))$">
    Require all denied
</FilesMatch>
